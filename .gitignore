# IDE files
.idea/
.vscode/
.fallow/

# Dotenv files (local secrets — never commit)
.env*
!.env.example

# MCP client config: paths are machine-specific, never commit the real file
.mcp.json
!.mcp.json.example

# Misc
*.txt
*.log
*.xls*
*.tgz
*.zip

# Build artifacts
dist/
build/

# Temporary folders
*tmp/
temp/
.cache/

# Local settings
/.*/settings*.json

# Skills
/.*/skills/
!/.*/skills/release

# SDD engine
/.magic/
/.*/skills/magic-*/
/.*/*/magic*.md

# SDD generated artifacts, rebuilt on demand by the engine (the rest of .design/ is shared)
/.design/*graph*.*
/.design/*cache*/
/.design/wiki/

# FreeCAD backup and temporary files
*.FCBak
*.FCStd[0-9]*
*.FCStd.bak
*.FCStd.tmp
*.FCMacro.tmp
Exports/

# IDE files
.idea/
.vscode/
.fallow/

# Dotenv files (local secrets — never commit)
.env*
!.env.example

# MCP client config: paths are machine-specific, never commit the real file
.mcp.json
!.mcp.json.example

# Misc
*.txt
*.log
*.xls*
*.tgz
*.zip

# Build artifacts
dist/
build/

# Temporary folders
*tmp/
temp/
.cache/

# Local settings
/.*/settings*.json

# SDD engine (installed from a release archive, not committed)
/.magic/
/.*/skills/magic-*/
/.*/*/magic*.md

## Generated graph artifacts
/.design/*graph*.*
/.design/*cache*/
/.design/wiki/

# FreeCAD backup and temporary files
*.FCBak
*.FCStd[0-9]*
*.FCStd.bak
*.FCStd.tmp
*.FCMacro.tmp

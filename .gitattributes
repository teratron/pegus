# Normalize line endings: every text file is stored and checked out with LF,
# regardless of a contributor's core.autocrlf setting.
* text=auto eol=lf

# Markdown files should use LF line endings
*.md text eol=lf

# Explicit scripts — always use CRLF.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Explicit binaries — never touch these.
*.hdr binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

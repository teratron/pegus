# Normalize line endings: every text file is stored and checked out with LF,
# regardless of a contributor's core.autocrlf setting.
* text=auto eol=lf

# Markdown files should use LF line endings
*.md text eol=lf

# Explicit scripts — always use CRLF.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Explicit binaries — never touch these.
*.hdr binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# FreeCAD native documents and mesh assets are binary containers or meshes.
*.FCStd binary
*.FCBak binary
*.FCStd[0-9]* binary
*.FCStd.bak binary
*.FCStd.tmp binary
*.FCMesh binary
*.stl binary
*.glb binary
*.3mf binary

# FreeCAD macros and text-based CAD exchange formats use LF line endings.
*.FCMacro text eol=lf
*.FCScript text eol=lf
*.FCMat text eol=lf
*.step text eol=lf
*.stp text eol=lf
*.iges text eol=lf
*.igs text eol=lf
*.dxf text eol=lf
*.obj text eol=lf
*.mtl text eol=lf
*.gltf text eol=lf
